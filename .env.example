# Conexão com o banco de dados.
#
# Desenvolvimento local (padrão): PGlite, um PostgreSQL embutido que grava em ./.data/pglite.
# Não precisa instalar nada. Se a variável não for definida, este é o valor usado fora de produção.
DATABASE_URL=pglite:./.data/pglite
#
# Produção (ou para usar um PostgreSQL real localmente), use uma URL postgres:
# DATABASE_URL=postgresql://usuario:senha@host:5432/banco?sslmode=require
